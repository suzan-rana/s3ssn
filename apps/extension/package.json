{
  "name": "s3ssn-vscode",
  "displayName": "S3ssn — Automatic Work Intelligence",
  "description": "Turn your real coding activity into XP, levels, and an automatic work log. Never reads your code, keystrokes, or screen.",
  "version": "0.0.1",
  "publisher": "s3ssn",
  "license": "MIT",
  "homepage": "https://s3ssn.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/s3ssn-labs/s3ssn.git",
    "directory": "apps/extension"
  },
  "bugs": {
    "url": "https://github.com/s3ssn-labs/s3ssn/issues"
  },
  "engines": { "vscode": "^1.85.0" },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#070708",
    "theme": "dark"
  },
  "categories": ["Other", "Visualization"],
  "keywords": [
    "time tracking",
    "productivity",
    "git",
    "engineering metrics",
    "gamification",
    "standup",
    "leaderboard"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "dev": "tsc -w -p ./",
    "build": "tsc -p ./",
    "vscode:prepublish": "tsc -p ./",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      { "command": "s3ssn.login", "title": "S3ssn: Sign in" },
      { "command": "s3ssn.logout", "title": "S3ssn: Sign out" },
      { "command": "s3ssn.pause", "title": "S3ssn: Pause tracking" },
      { "command": "s3ssn.resume", "title": "S3ssn: Resume tracking" },
      { "command": "s3ssn.status", "title": "S3ssn: Show status" },
      { "command": "s3ssn.openDashboard", "title": "S3ssn: Open dashboard" }
    ],
    "configuration": {
      "title": "S3ssn",
      "properties": {
        "s3ssn.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000/v1",
          "description": "S3ssn API base URL."
        },
        "s3ssn.webBaseUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "S3ssn web dashboard base URL (used for browser sign-in)."
        },
        "s3ssn.idleThresholdSeconds": {
          "type": "number",
          "default": 120,
          "description": "Seconds with no editor activity before a session is considered idle."
        },
        "s3ssn.heartbeatIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "How often to emit a heartbeat while you are actively editing."
        },
        "s3ssn.flushIntervalSeconds": {
          "type": "number",
          "default": 60,
          "description": "How often to flush batched events to the backend."
        },
        "s3ssn.excludedRepos": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Repository remote hashes to exclude from tracking."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@s3ssn/types": "workspace:*"
  }
}
